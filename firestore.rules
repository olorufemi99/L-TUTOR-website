rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function permanentAdmin() {
      return signedIn()
        && request.auth.token.email == "olorufemi99@gmail.com";
    }

    function studentAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/students/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/students/$(request.auth.uid)).data.isAdmin == true
          || get(/databases/$(database)/documents/students/$(request.auth.uid)).data.role == "admin"
          || get(/databases/$(database)/documents/students/$(request.auth.uid)).data.role == "administrator"
        );
    }

    function admin() {
      return permanentAdmin() || studentAdmin();
    }

    match /news/{id} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    match /courses/{id} {
      allow read: if signedIn();
      allow create, update, delete: if admin();
    }

    match /lecturers/{id} {
      allow read: if signedIn();
      allow create, update, delete: if admin();
    }

    match /lectureNotes/{id} {
      allow read: if signedIn();
      allow create, update, delete: if admin();
    }

    match /pastQuestions/{id} {
      allow read: if signedIn();
      allow create, update, delete: if admin();
    }

    match /videos/{id} {
      allow read: if signedIn();
      allow create, update, delete: if admin();
    }

    match /books/{id} {
      allow read: if signedIn();
      allow create, update, delete: if admin();
    }

    match /announcements/{id} {
      allow read: if signedIn();
      allow create, update, delete: if admin();
    }

    match /heroSlides/{id} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    match /students/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if admin()
        || (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "fullname", "phone", "passport", "passportFileName",
            "passportUpdatedAt", "updatedAt"
          ])
        );
      allow delete: if admin();
    }

    match /studentSettings/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /matricRegistry/{matric} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if admin();
    }

    match /settings/{id} {
      allow read, create, update, delete: if admin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
